MONGODB_URI=mongodb://localhost:27017/st-space
ADMIN_EMAIL=admin@st-space.com
# Generate with: node scripts/hash-password.mjs "yourpassword" and paste the printed line.
# Every "$" in the hash must be escaped as "\$", e.g. ADMIN_PASSWORD_HASH=\$2b\$12\$...
ADMIN_PASSWORD_HASH=
# Long random string, e.g. output of: openssl rand -base64 48
JWT_SECRET=
# Allowed CORS origin(s) for /api/public/* (comma-separated)
WEBSITE_ORIGIN=http://localhost:3000

# Public website URL used for "View Website" / "View on site" links
NEXT_PUBLIC_WEBSITE_URL=http://localhost:3000
# Server-side website URL used to trigger on-demand revalidation
WEBSITE_URL=http://localhost:3000
# Must match REVALIDATE_SECRET in website/.env.local
REVALIDATE_SECRET=

# Cloudflare R2 (facility image uploads). Create an R2 bucket with public access
# (r2.dev subdomain or a custom domain) and an API token with Object Read & Write.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Public base URL of the bucket, e.g. https://pub-xxxx.r2.dev or https://images.st-space.com
R2_PUBLIC_URL=
