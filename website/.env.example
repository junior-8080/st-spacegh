# Base URL of the admin app (it serves the public API)
NEXT_PUBLIC_ADMIN_API_URL=http://localhost:3001
# Public URL of this website (used for metadata, sitemap and share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret for POST /api/revalidate; must match REVALIDATE_SECRET in admin/.env.local
REVALIDATE_SECRET=
